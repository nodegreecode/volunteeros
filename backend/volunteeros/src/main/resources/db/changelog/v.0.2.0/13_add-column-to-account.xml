<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-account-status-enum" author="avasylenko">

        <sql>
            CREATE TYPE account_status AS ENUM (
            'PENDING',
            'ACTIVE',
            'SUSPENDED',
            'CLOSED'
            );
        </sql>

    </changeSet>

    <changeSet id="add-account-status-column-to-account" author="avasylenko">

        <addColumn tableName="account">
            <column name="status" type="account_status">
                <constraints nullable="true"/>
            </column>
        </addColumn>

    </changeSet>

    <changeSet id="backfill-account-status-active" author="avasylenko">

        <sql>
            UPDATE account
            SET status = 'ACTIVE'
            WHERE status IS NULL;
        </sql>

    </changeSet>

    <changeSet id="make-account-status-not-null" author="avasylenko">

        <addNotNullConstraint
                tableName="account"
                columnName="status"
                columnDataType="account_status"/>

    </changeSet>
</databaseChangeLog>