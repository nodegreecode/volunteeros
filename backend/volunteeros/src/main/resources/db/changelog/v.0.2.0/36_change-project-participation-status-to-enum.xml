<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">


    <changeSet id="change-project-participation-status-to-enum" author="avasylenko">

        <sql>
            CREATE TYPE project_participation_status AS ENUM (
            'PENDING',
            'APPROVED',
            'REJECTED'
            );
        </sql>

        <sql>
            ALTER TABLE project_participation
            ALTER COLUMN status TYPE project_participation_status
            USING status::project_participation_status;
        </sql>
    </changeSet>
</databaseChangeLog>