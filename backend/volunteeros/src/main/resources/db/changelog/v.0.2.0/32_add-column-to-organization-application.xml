<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="add-description-to-organization-application" author="avasylenko">
        <addColumn tableName="organization_application">
            <column name="description" type="varchar(1000)"/>
        </addColumn>
    </changeSet>

    <changeSet id="add-member-role-to-organization-application" author="avasylenko">
        <addColumn tableName="organization_application">
            <column name="member_role"
                    type="varchar(50)">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="add-not-null-description-organization-application" author="avasylenko">
        <addNotNullConstraint
                tableName="organization_application"
                columnName="description"
                columnDataType="varchar(1000)"/>
    </changeSet>
</databaseChangeLog>