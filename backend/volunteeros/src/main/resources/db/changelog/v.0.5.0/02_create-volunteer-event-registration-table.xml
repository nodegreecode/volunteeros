<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-volunteer-event-registration-status-enum" author="avasylenko">

        <sql>
            CREATE TYPE volunteer_event_registration_status AS ENUM (
            'REGISTERED',
            'CANCELLED',
            'ATTENDED',
            'NO_SHOW'
            );
        </sql>

    </changeSet>

    <changeSet id="create-volunteer-event-registration-table" author="avasylenko">

        <createTable tableName="volunteer_event_registration">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"
                             nullable="false"/>
            </column>
            <column name="event_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="volunteer_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="volunteer_event_registration_status"
                    defaultValue="REGISTERED">
                <constraints nullable="false"/>
            </column>
            <column name="qr_token" type="VARCHAR(255)">
                <constraints nullable="false"
                             unique="true"/>
            </column>
            <column name="registered_at" type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="checked_in_at" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="volunteer_event_registration"
                baseColumnNames="event_id"
                referencedTableName="project_event"
                referencedColumnNames="id"
                constraintName="fk_registration_project_event"/>

        <addForeignKeyConstraint
                baseTableName="volunteer_event_registration"
                baseColumnNames="volunteer_id"
                referencedTableName="account"
                referencedColumnNames="id"
                constraintName="fk_volunteer_event_registration_account"/>

        <!-- One volunteer can register only once per event -->
        <addUniqueConstraint
                tableName="volunteer_event_registration"
                columnNames="event_id, volunteer_id"
                constraintName="uk_event_volunteer_registration"/>

        <createIndex tableName="volunteer_event_registration"
                     indexName="idx_registration_qr_token">
            <column name="qr_token"/>
        </createIndex>

        <createIndex tableName="volunteer_event_registration"
                     indexName="idx_registration_event_id">
            <column name="event_id"/>
        </createIndex>

        <createIndex tableName="volunteer_event_registration"
                     indexName="idx_registration_volunteer_id">
            <column name="volunteer_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>